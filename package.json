{
  "name": "telegram-green-chat",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4174",
    "build": "tsc -b && vite build && echo 'build verification passed'",
    "preview": "vite preview --host 0.0.0.0 --port 4174",
    "lint": "eslint . && node scripts/verify-fsd.mjs && echo 'lint verification passed'",
    "test": "vitest",
    "test:run": "vitest run && echo 'test verification passed'",
    "verify": "npm run lint && npm run test:run && npm run build && node scripts/verify-project.mjs && node scripts/verify-localization.mjs"
  },
  "dependencies": {
    "i18next": "^26.4.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-i18next": "^17.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "axe-core": "^4.13.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vitest": "^4.1.11"
  }
}
